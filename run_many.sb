#!/bin/bash --login
#SBATCH --job-name=pignet2
#SBATCH --time=08:00:00
#SBATCH --mem=32G
#SBATCH --gpus=h200:1
#SBATCH --cpus-per-task=2
#SBATCH --output=/mnt/scratch/jeaves/Sfcnn/logs/%x_%A_%a.out
#SBATCH --error=/mnt/scratch/jeaves/Sfcnn/logs/%x_%A_%a.err

#set -euo pipefail

module purge
module load Miniforge3
conda activate sfcnn

BASE_DIR="/mnt/scratch/jeaves/Sfcnn"
CSV_PATH="${BASE_DIR}/casf2016_smiles_seqs_cleaned.csv"
OUT_CSV="${BASE_DIR}/casf2016_Sfcnn_preds_and_times.csv"

echo "pdbid,pK_predicted,t_tot_s" > "$OUT_CSV"

while IFS=',' read -r pdbid smiles sequence || [[ -n "$pdbid" ]]; do
    pdbid="${pdbid//$'\r'/}"
    pdbid="${pdbid//\"/}"
    pdbid="$(echo "$pdbid" | xargs)"

    protein="${BASE_DIR}/coreset/${pdbid}/${pdbid}_protein.pdb"
    ligand="${BASE_DIR}/coreset/${pdbid}/${pdbid}_ligand.mol2"

    py_out=$(python predict.py -p "$protein" -l "$ligand" | tail -1)

    pk=$(echo "$py_out" | awk '{print $1}')
    t=$(echo "$py_out" | awk '{print $2}')

    echo "${pdbid},${pk},${t}" | tee -a "$OUT_CSV"

done < <(tail -n +2 "$CSV_PATH")

